    local startPos = root.Position + Vector3.new(0,2,0)
    local distance = (targetPos - startPos).Magnitude; local time = distance / SpearAim.Speed
    return targetPos + Vector3.new(0, 0.5 * SpearAim.Gravity * time * time, 0)
end

