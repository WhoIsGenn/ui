-- FOV Circle Drawing
local FOV_SEGMENTS = 48
local FOVLines = {}
local FOVInitialized = false
local function initFOVLines()
    if FOVInitialized then return end
    FOVInitialized = true
    for i = 1, FOV_SEGMENTS do
        local l = Drawing.new("Line")
        l.Thickness = 1.5
        l.Color = Color3.fromRGB(0, 170, 255)
        l.Transparency = 1
        l.Visible = false
        FOVLines[i] = l
    end
end

local FOVConfig = {
    GunAimShow    = false,
    AttackAimShow = false,
    VeilShow      = false,
    SilentAimShow = false,
    GunAimColor    = Color3.fromRGB(0, 170, 255),
    AttackAimColor = Color3.fromRGB(255, 60, 60),
    VeilColor      = Color3.fromRGB(170, 0, 255),
    SilentAimColor = Color3.fromRGB(255, 170, 0),
    Thickness     = 1.5
}

local function updateFOVCircle()
    if not FOVInitialized then initFOVLines() end
    local cam = workspace.CurrentCamera
    local cx = cam.ViewportSize.X / 2
    local cy = cam.ViewportSize.Y / 2

    -- Priority: Gun Aim > Attack Aim > Veil > Silent Aim
    local radius, color = nil, nil
    if GunAim.Enabled and FOVConfig.GunAimShow then
        radius = GunAim.FOV
        color  = FOVConfig.GunAimColor
    elseif AttackAim.Enabled and FOVConfig.AttackAimShow then
        radius = AttackAim.FOV
        color  = FOVConfig.AttackAimColor
    elseif SilentAimVeil.Enabled and FOVConfig.VeilShow then
        radius = SilentAimVeil.FOV
        color  = FOVConfig.VeilColor
    elseif SilentAim.Enabled and FOVConfig.SilentAimShow then
        radius = 150
        color  = FOVConfig.SilentAimColor
    end

    if radius and color then
        for i = 1, FOV_SEGMENTS do
            local a1 = (i-1) / FOV_SEGMENTS * math.pi * 2
            local a2 = i     / FOV_SEGMENTS * math.pi * 2
            FOVLines[i].From      = Vector2.new(cx + math.cos(a1) * radius, cy + math.sin(a1) * radius)
            FOVLines[i].To        = Vector2.new(cx + math.cos(a2) * radius, cy + math.sin(a2) * radius)
            FOVLines[i].Color     = color
            FOVLines[i].Thickness = FOVConfig.Thickness
            FOVLines[i].Visible   = true
        end
    else
        for i = 1, FOV_SEGMENTS do FOVLines[i].Visible = false end
    end
end
