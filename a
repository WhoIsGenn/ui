local manual_spam_accumulator = 0

local function get_manual_spam_interval()
    local cps = getgenv().ManualSpamCPS or 1
    return 1 / math.max(cps, 1)
end

function System.manual_spam.start()
    if System.__properties.__connections.__manual_spam then
        System.__properties.__connections.__manual_spam:Disconnect()
    end
    manual_spam_accumulator = 0
    System.__properties.__connections.__manual_spam = RunService.Heartbeat:Connect(function(dt)
        if not System.__properties.__manual_spam_enabled then return end
        manual_spam_accumulator = manual_spam_accumulator + dt
        local interval = get_manual_spam_interval()
        if manual_spam_accumulator < interval then return end
        manual_spam_accumulator = manual_spam_accumulator - interval
        System.parry.execute()
    end)
end

function System.manual_spam.stop()
    if System.__properties.__connections.__manual_spam then
        System.__properties.__connections.__manual_spam:Disconnect()
        System.__properties.__connections.__manual_spam = nil
    end
end

-- ================================================================
-- [10] AUTO SPAM
-- ================================================================

function System.auto_spam.start()
    if System.__properties.__connections.__auto_spam then
        System.__properties.__connections.__auto_spam:Disconnect()
    end
    System.__properties.__connections.__auto_spam = RunService.PreSimulation:Connect(function()
        if not System.__properties.__auto_spam_enabled then return end
        if not LocalPlayer.Character or not LocalPlayer.Character.PrimaryPart then return end
        local ball = System.ball.get()
        if not ball then return end
        local zoomies = ball:FindFirstChild("zoomies")
        if not zoomies then return end
        local distance = (LocalPlayer.Character.PrimaryPart.Position - ball.Position).Magnitude
        local threshold = (System.__properties.__spam_threshold or 1.5) *
                          (System.__properties.__auto_spam_distance_multiplier or 0.3) * 100
        if distance <= threshold then
            if getgenv().AutoSpamMode == "Keypress" then
                System.parry.keypress()
            else
                System.parry.execute()
            end
        end
    end)
end

function System.auto_spam.stop()
    if System.__properties.__connections.__auto_spam then
        System.__properties.__connections.__auto_spam:Disconnect()
        System.__properties.__connections.__auto_spam = nil
    end
end

