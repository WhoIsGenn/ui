                    local interval = math.clamp(tonumber(getgenv().PlayerFollowTPInterval) or 0.15, 0.05, 1)
                    if teleportAcc < interval then return end
                    teleportAcc = 0
                    local dist = math.clamp(tonumber(getgenv().PlayerFollowTPDistance) or 4, 2, 15)
