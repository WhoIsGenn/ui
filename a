function System.triggerbot.enable(state)
    System.__triggerbot.__enabled = state
    if state then
        if System.__properties.__connections.__triggerbot then
            System.__properties.__connections.__triggerbot:Disconnect()
        end
        System.__properties.__connections.__triggerbot = RunService.PreSimulation:Connect(function()
            if not System.__triggerbot.__enabled then return end
            local ball = System.ball.get()
            if not ball then return end
            local zoomies = ball:FindFirstChild("zoomies")
            if not zoomies then return end
            if ball:GetAttribute("target") ~= LocalPlayer.Name then return end
            if System.__triggerbot.__is_parrying then return end
            System.__triggerbot.__is_parrying = true
            task.delay(System.__triggerbot.__parry_delay, function()
                System.parry.execute()
                System.__triggerbot.__is_parrying = false
            end)
        end)
    else
        if System.__properties.__connections.__triggerbot then
            System.__properties.__connections.__triggerbot:Disconnect()
            System.__properties.__connections.__triggerbot = nil
        end
    end
end

