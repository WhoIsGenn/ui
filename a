local SecVisualiser = TabVisuals:AddSection({ Title = "Visualiser" })

SecVisualiser:AddToggle({
    Title="Parry Visualiser", Flag="Visualiser", Default=false,
    Callback=function(value)
        getgenv().Visualiser = value
        if value then
            if not visualiser_model then
                visualiser_model = Instance.new("Model")
                visualiser_model.Name = "VisualiserModel"; visualiser_model.Parent = workspace
                for i = 1, 128 do
                    local edge = Instance.new("Part")
                    edge.Name = "VE"..i; edge.Anchored = true; edge.CanCollide = false
                    edge.CastShadow = false; edge.Material = Enum.Material.Neon
                    edge.Color = Color3.fromRGB(255,255,255); edge.Transparency = 0.25
                    edge.Size = Vector3.new(0.08,0.08,0.18); edge.Parent = visualiser_model
                    visualiser_edges[i] = edge
                end
            end
            Connections_Manager["Visualiser"] = RunService.RenderStepped:Connect(function()
                local char = Player.Character
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                local hueVal = getgenv().VisualiserHue or 0
                for _, edge in pairs(visualiser_edges) do
                    if edge then
                        edge.Color = getgenv().VisualiserRainbow
                            and Color3.fromHSV((tick()%5)/5, 1, 1)
                            or  Color3.fromHSV(hueVal/360, 1, 1)
                    end
                end
                local speed = 0
                local bf = workspace:FindFirstChild("Balls")
                if bf then
                    for _, ball in pairs(bf:GetChildren()) do
                        if ball and ball:FindFirstChild("zoomies") then
                            speed = math.min(ball.AssemblyLinearVelocity.Magnitude, 350) / 6.5; break
                        end
                    end
                end
                local size = math.max(speed, 6.5); local radius = size * 0.5
                local count = #visualiser_edges
                local segLen = math.max(0.25, (2 * math.pi * radius) / count)
                for idx, edge in ipairs(visualiser_edges) do
                    if edge and hrp then
                        local angle = (idx-1) * (2*math.pi/count)
                        edge.Size  = Vector3.new(0.05, 0.05, segLen)
                        edge.CFrame = hrp.CFrame
                            * CFrame.new(math.cos(angle)*radius, -3, math.sin(angle)*radius)
                            * CFrame.Angles(0, angle + math.pi/2, 0)
                    end
                end
            end)
        else
            if Connections_Manager["Visualiser"] then
                Connections_Manager["Visualiser"]:Disconnect(); Connections_Manager["Visualiser"] = nil
            end
            if visualiser_model then visualiser_model:Destroy(); visualiser_model = nil; visualiser_edges = {} end
        end
    end,
})

