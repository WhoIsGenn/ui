            local head = char:FindFirstChild("Head")
            if not head then return end
            head.Transparency = 0
            for _, c in ipairs(head:GetChildren()) do
                if c:IsA("Decal") or c.Name == "face" then c.Transparency = 0 end
            end
        end
        if value then
            _G.PlayerCosmeticsCleanup = _G.PlayerCosmeticsCleanup or {}
            if lp.Character then applyKorblox(lp.Character); applyHeadless(lp.Character) end
            if _G.PlayerCosmeticsCleanup.conn then _G.PlayerCosmeticsCleanup.conn:Disconnect() end
            _G.PlayerCosmeticsCleanup.conn = lp.CharacterAdded:Connect(function(char)
                task.wait(0.5); applyKorblox(char); applyHeadless(char)
            end)
        else
            if _G.PlayerCosmeticsCleanup and _G.PlayerCosmeticsCleanup.conn then
                _G.PlayerCosmeticsCleanup.conn:Disconnect()
            end
            if lp.Character then restoreHeadless(lp.Character); restoreKorblox(lp.Character) end
            _G.PlayerCosmeticsCleanup = {}
        end
    end,
})

