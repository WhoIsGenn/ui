-- ═══ TARGET PLAYER ═════════════════════════════════════════════════════
function Auto_Parry.GetTargetPlayer()
    local alive = workspace:FindFirstChild("Alive")
    local myChar = LocalPlayer.Character
    if not alive or not myChar then return nil end
    local myRoot = myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local cam = workspace.CurrentCamera
    if not cam then return nil end

    local bestTarget = nil
    local maxDot = -1
    for _, p in ipairs(alive:GetChildren()) do
        local hrp = p:FindFirstChild("HumanoidRootPart")
        if p ~= myChar and p:IsA("Model") and hrp then
            local targetDir = (hrp.Position - cam.CFrame.Position).Unit
            local camDot = cam.CFrame.LookVector:Dot(targetDir)
            if camDot > 0 and camDot > maxDot then
                maxDot = camDot
                bestTarget = p
            end
        end
    end

    if not bestTarget then
        local minDist = math.huge
        for _, p in ipairs(alive:GetChildren()) do
            local hrp = p:FindFirstChild("HumanoidRootPart")
            if p ~= myChar and p:IsA("Model") and hrp then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < minDist then minDist = d; bestTarget = p end
            end
        end
    end
    return bestTarget
end

-- ═══ CURVE CFRAME ══════════════════════════════════════════════════════
function Auto_Parry.CalculateParryCFrame(ball, targetPlayer)
    local cam = workspace.CurrentCamera
    if not cam then return CFrame.new() end

    local camPos = cam.CFrame.Position
    local mode = Config.ParryCurveDirection or "Camera"

    if mode == "Camera" then
        return cam.CFrame
    end

    local targetPos
    if targetPlayer and targetPlayer.PrimaryPart then
        targetPos = targetPlayer.PrimaryPart.Position
    elseif ball and ball.Parent then
        targetPos = ball.Position
    else
        targetPos = camPos + cam.CFrame.LookVector * 100
    end

    local camLook  = cam.CFrame.LookVector
    local camRight = cam.CFrame.RightVector
    local camUp    = cam.CFrame.UpVector

    if mode == "Left" then
        return CFrame.new(camPos, camPos + (camRight * -1) * 100)
    elseif mode == "Right" then
        return CFrame.new(camPos, camPos + (camRight * 1) * 100)
    elseif mode == "Up" then
        return CFrame.new(camPos, camPos + (camUp * 1) * 100)
    elseif mode == "Down" then
        return CFrame.new(camPos, camPos + (camUp * -1) * 100)
    elseif mode == "Backwards" then
        return CFrame.new(camPos, camPos + (camLook * -1) * 100)
    elseif mode == "Random" then
        return CFrame.new(camPos, camPos + Vector3.new(math.random(-100, 100), math.random(-100, 100), math.random(-100, 100)))
    elseif mode == "Straight" then
        return CFrame.new(camPos, targetPos)
    end

    return cam.CFrame
end

Auto_Parry.CalculateParryCframe = Auto_Parry.CalculateParryCFrame

-- ═══ REMOTE FINDER & TOKENIZER ═════════════════════════════════════════
local replicated_storage = cloneref(game:GetService('ReplicatedStorage'))
local workspace_ref = cloneref(game:GetService('Workspace'))

local _token
for _, Function in getgc(true) do
    if type(Function) ~= 'function' or not debug.info(Function, 's'):find('PRY', 1, true) then
        continue
    end
    for _, value in debug.getupvalues(Function) do
        if type(value) == 'function' then _token = value; break end
    end
    if _token then break end
end

function _tokenize(_remote_uid)
    local time = tostring(math.floor(workspace_ref:GetServerTimeNow() * 100))
    local key = _token(_remote_uid, 'TIME')
    local characters = table.create(#time)
    for index = 1, #time do
        characters[index] = string.char(bit32.bxor(
            (string.byte(time, index) + index) % 256,
            string.byte(key, (index - 1) % #key + 1)
        ))
    end
    return table.concat(characters)
end

local _reverted = {}
local _original = {}
local _captured = nil

function _is_valid(args)
    if not args or #args < 8 then return false end
    if type(args[2]) ~= "string" or type(args[3]) ~= "string" then return false end
    if typeof(args[5]) ~= "CFrame" then return false end
    return true
end

function _hook(remote)
    if not _reverted[remote] then
        if not _original[getrawmetatable(remote)] then
            _original[getrawmetatable(remote)] = true
            local _meta = getrawmetatable(remote)
            setreadonly(_meta, false)
            local _old = _meta.__index
            _meta.__index = function(self, key)
                if (key == 'FireServer' and self:IsA('RemoteEvent')) or
                   (key == 'InvokeServer' and self:IsA('RemoteFunction')) then
                    return function(_, ...)
                        local _arguments = {...}
                        if _is_valid(_arguments) then
                            if not _reverted[self] then
                                _reverted[self] = _arguments
                                _captured = { remote = self, args = _arguments }
                            end
                        end
                        return _old(self, key)(_, unpack(_arguments))
                    end
                end
                return _old(self, key)
            end
            setreadonly(_meta, true)
        end
    end
end

for _iterator, _remote in pairs(replicated_storage:GetDescendants()) do
    if _remote:IsA('RemoteEvent') or _remote:IsA('RemoteFunction') then
        _hook(_remote)
    end
end

-- ═══ FIRE PARRY REMOTE ═════════════════════════════════════════════════
function Auto_Parry.FireParryRemote(isSpam)
    if not _reverted or next(_reverted) == nil then return end
    local ball = Auto_Parry.Get_Ball()
    local cam = workspace.CurrentCamera
    if not cam then return end

    local targetPlayer = Auto_Parry.GetTargetPlayer()
    local curveCF = Auto_Parry.CalculateParryCFrame(ball, targetPlayer)

    local alive = workspace:FindFirstChild("Alive")
    local curTime = os.clock()

    if curTime - Cache_Update_Tick > 0.1 then
        table.clear(Last_Positions_Cache)
        if alive then
            for _, character in ipairs(alive:GetChildren()) do
                if character:IsA("Model") and character.PrimaryPart then
                    if character.Name ~= LocalPlayer.Name then
                        Last_Positions_Cache[character.Name] = character.PrimaryPart.Position
                    end
                end
            end
            local myChar = LocalPlayer.Character
            local myHrp = myChar and (myChar.PrimaryPart or myChar:FindFirstChild("HumanoidRootPart"))
            if myHrp then Last_Positions_Cache[LocalPlayer.Name] = myHrp.Position end
        end
        Cache_Update_Tick = curTime
    end

    for _remote, _originalArgs in pairs(_reverted) do
        if type(_originalArgs) == "table" and _originalArgs ~= nil then
            task.spawn(function()
                local centerX = cam.ViewportSize.X / 2
                local centerY = cam.ViewportSize.Y / 2
                pcall(function()
                    if _remote:IsA("RemoteEvent") then
                        _remote:FireServer(
                            _originalArgs[1], _originalArgs[2],
                            _tokenize(_originalArgs[2]),
                            isSpam and 0.001 or 0.5,
                            curveCF or cam.CFrame,
                            Last_Positions_Cache,
                            {centerX, centerY}, false
                        )
                    end
                end)
            end)
        end
    end
end

